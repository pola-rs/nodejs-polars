{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noParameterAssign": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noThenProperty": "off",
        "noApproximativeNumericConstant": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noArguments": "off"
      }
    },
    "includes": [
      "**",
      "!**/polars/native-polars.js",
      "!**/polars/run.js",
      "!docs/**/*",
      "!bin/**/*"
    ]
  },
  "formatter": {
    "indentWidth": 2,
    "indentStyle": "space",
    "includes": [
      "**",
      "!**/polars/native-polars.js",
      "!**/polars/run.js",
      "!docs/**/*",
      "!bin/**/*"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
